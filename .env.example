# Copy to .env and fill in. Never commit .env.
# Token Factory models are free to users during its beta (pricing "free" in config/models.json): a
# balance key is needed, nothing is charged. docs/PAYMENTS.md, Free models.
TOKENFACTORY_API_KEY=
TINFOIL_API_KEY=

# Accepted mints (comma separated). Default: the Forge mint only.
FORGE_TRUSTED_MINTS=https://forge.flashapp.me
# Other addresses of the same mint (alias=main); tokens under an alias are handled under the main address.
FORGE_MINT_ALIASES=https://mint.forge-reserve.com=https://forge.flashapp.me
FORGE_UNITS=usd,sat
FORGE_DEFAULT_UNIT=usd
FORGE_INVITE_ONLY=true
# Applies to paid models only; a free model costs 0.
FORGE_MARKUP=1.25

# Optional: 64-byte hex seed for the gateway's deterministic eCash outputs (NUT-13).
# If unset, one is generated and stored in the database. Back up the database either way.
# FORGE_WALLET_SEED=

# FORGE_RATE_SOURCES=coinbase,kraken,bitstamp
# FORGE_RATE_MIN_SOURCES=2
# FORGE_RATE_LIMIT_RPM=60
# FORGE_MAX_BODY_BYTES=1000000
# FORGE_AUDIO_MAX_BYTES=4000000
# Free voice questions (docs/PAYMENTS.md): speech to text for a balance that cannot pay for it, paid by
# the operator. Per balance per UTC day, and the operator's daily budget in USD at the supplier's cost.
# Either at 0 turns them off.
# FORGE_FREE_VOICE_PER_DAY=20
# FORGE_FREE_VOICE_BUDGET_USD=5.00
# FORGE_LOG_LEVEL=info

# Funding a balance through the Forge mint (see docs/PAYMENTS.md).
# FORGE_FUND_MINT=https://forge.flashapp.me     # default: first trusted mint
# FORGE_LIGHTNING_ENABLED=true
# FORGE_FUND_MAX_SAT=1000000
# FORGE_FUND_MAX_USD=50000                       # cents
# FORGE_MINT_QUOTE_CHECKS_PER_MIN=12             # all fundings share the mint's per-IP limit (Nutshell: 20/min)
# On-chain (NUT-30) is off until tested against the live mint:
# FORGE_ONCHAIN_ENABLED=false
# FORGE_ONCHAIN_CONFIRMATIONS=3                  # shown to users; the mint decides
# FORGE_ESPLORA_URL=                             # optional, e.g. your own mempool instance
# eCash from other mints:
# FORGE_FOREIGN_ENABLED=true
# FORGE_FOREIGN_POLICY=discovered               # discovered | allowlist | any
# FORGE_FOREIGN_ALLOW=                           # operator list of accepted mints (the admin page can add more)
# FORGE_FOREIGN_DENY=                            # never accepted; wins over everything
# FORGE_FOREIGN_MIN_REVIEWERS=2                  # NIP-87 reviewers a discovered mint needs
# FORGE_FOREIGN_REQUIRE_ANNOUNCEMENT=false        # also require the mint's own NIP-87 announcement
# FORGE_FOREIGN_DISCOVERY_RELAYS=wss://relay.damus.io,wss://nos.lol,wss://relay.primal.net   # empty = no discovery
# FORGE_FOREIGN_DISCOVERY_TTL_MINUTES=60
# FORGE_FOREIGN_MAX_DISCOVERED=25
# FORGE_FOREIGN_MAX_SAT=100000
# FORGE_FOREIGN_MAX_USD=5000                     # cents
# FORGE_FOREIGN_UNLISTED=true                    # customers may use a mint that is not listed, after a warning
# FORGE_FOREIGN_UNLISTED_MAX_SAT=5000            # cap for an unlisted mint
# FORGE_FOREIGN_UNLISTED_MAX_USD=500             # cents

# Admin page (/admin, see docs/ADMIN.md). Unset FORGE_ADMIN_TOKEN_HASH: the admin page and API answer 404.
# FORGE_ADMIN_TOKEN_HASH=<sha256 hex of the admin token>
# FORGE_ADMIN_ORIGIN=https://ai.forge-reserve.com
# Caddy basic auth on /admin* (required by docker-compose.yml). Single quotes: the bcrypt hash contains "$".
# FORGE_ADMIN_BASIC_AUTH_USER=forge
# FORGE_ADMIN_BASIC_AUTH_HASH='<output of: docker run --rm -it caddy:2.11.9@sha256:4e2425f6009577e7c651010f16679c28f7d12df3e7b1914f941a7a3370746b3c caddy hash-password>'
