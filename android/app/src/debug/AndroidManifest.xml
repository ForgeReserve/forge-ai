<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only: ForgeAsr's check from adb without the app's screen (AsrCheckService), so a phone in
  use is not taken over. A foreground service, exported only to callers holding DUMP (the adb shell, never
  an app). A release build has none of this.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application>
        <service
            android:name=".AsrCheckService"
            android:foregroundServiceType="specialUse"
            android:permission="android.permission.DUMP"
            android:exported="true">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Debug-only speech to text check started from adb" />
        </service>
    </application>
</manifest>
