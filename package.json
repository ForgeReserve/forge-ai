{
  "name": "forge-ai",
  "version": "0.1.0",
  "description": "Pay-per-request OpenAI-compatible AI gateway paid with Cashu eCash",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run test/unit",
    "test:e2e": "vitest run test/e2e",
    "test:ui": "vitest run test/ui",
    "test:ui:voice": "vitest run test/ui/phonon",
    "test:ui:linux": "scripts/ui-linux.sh",
    "ios:web": "node scripts/ios-web.ts",
    "test:live": "node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run test/live",
    "mint:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "mint:down": "docker compose -f docker-compose.test.yml down",
    "admin": "node src/admin.ts",
    "demo:agent": "tsx examples/agent-pays.ts",
    "test-token": "tsx scripts/test-token.ts",
    "print-notes": "node scripts/print-notes.ts",
    "issue-credits": "node scripts/issue-credits.ts",
    "build:docs": "node scripts/build-docs.ts"
  },
  "dependencies": {
    "@cashu/cashu-ts": "^4.13.0",
    "@hono/node-server": "^2.1.6",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "hono": "^4.13.17",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@capacitor/android": "6.2.3",
    "@capacitor/core": "6.2.3",
    "@capacitor/ios": "6.2.3",
    "@fontsource-variable/baloo-2": "5.3.0",
    "@fontsource-variable/nunito": "5.3.0",
    "@types/node": "^26.6.6",
    "playwright-core": "^1.65.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.15.0"
}
